<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="focusMinutes" type="Int"><default>25</default></entry>
    <entry name="breakMinutes" type="Int"><default>5</default></entry>
    <entry name="longBreakMinutes" type="Int"><default>15</default></entry>
    <entry name="projects" type="String"><default></default></entry>
    <entry name="dndDuringFocus" type="Bool"><default>false</default></entry>
    <!-- running state, so a timer survives a Plasma restart -->
    <entry name="phase" type="String"><default>idle</default></entry>
    <entry name="endsAt" type="String"><default>0</default></entry>
    <entry name="pausedLeft" type="Int"><default>0</default></entry>
    <entry name="project" type="String"><default></default></entry>
    <entry name="streak" type="Int"><default>0</default></entry>
    <entry name="stats" type="String"><default>{}</default></entry>
  </group>
</kcfg>
