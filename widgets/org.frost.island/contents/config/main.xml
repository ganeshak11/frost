<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
  <kcfgfile name=""/>
  <group name="General">
    <!-- island timer and stopwatch, kept here so they survive a Plasma restart -->
    <entry name="timerEnd" type="String"><default>0</default></entry>
    <entry name="timerTotal" type="Int"><default>0</default></entry>
    <entry name="timerLeft" type="Int"><default>0</default></entry>
    <entry name="customMinutes" type="Int"><default>15</default></entry>
    <entry name="swStart" type="String"><default>0</default></entry>
    <entry name="swAcc" type="String"><default>0</default></entry>
    <entry name="swRunning" type="Bool"><default>false</default></entry>
  </group>
</kcfg>
