#!/usr/bin/env python3
"""Frost Link: makes the phone (Frost Mobile) and this laptop work as one machine.

  frost-link daemon     run the service (started at login by the autostart entry)
  frost-link phone      print what the phone last reported (used by the laptop widgets)
  frost-link status     print this laptop's status as the phone sees it

It listens on two addresses, both port 47830:
  this laptop's Tailscale address, for the phone. Every request is checked with
      `tailscale whois`: only devices of this laptop's own Tailscale user are answered.
      Tailscale already encrypts the traffic; nothing listens on Wi-Fi or the internet.
  127.0.0.1, for this laptop's own Frost widgets.

What travels over it:
  notes        ~/.local/share/frost-notes/*.md, both ways (the phone does the merging)
  screen time  the phone's days go to ~/.local/share/frost/screentime/phone/YYYY-MM-DD.json;
               the phone reads this laptop's days back. Only app names and seconds, never titles.
  status       the phone's battery and music land in ~/.local/share/frost/link/phone.json;
               the phone reads this laptop's battery and music, and can play/pause/skip it.
The phone always calls the laptop (Android can't keep a server running), every few
minutes and whenever Frost opens. If the laptop is off, the phone catches up later.
"""
import hashlib
import json
import os
import re
import socket
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PORT = 47830
DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
NOTES = DATA / "frost-notes"
SCREEN = DATA / "frost/screentime"
LINK = DATA / "frost/link"
ID_RE = re.compile(r"^[A-Za-z0-9._-]{1,80}$")
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
VERSION = 1


def sh(*cmd, timeout=3):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def write_atomic(path: Path, data: bytes, mtime=None):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    with open(tmp, "wb") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    if mtime:
        os.utime(path, (mtime, mtime))


# ---------- who may talk to us: only this Tailscale user's own devices ----------
_me = {"user": None, "at": 0}
_seen = {}          # ip -> (allowed, checked_at)


def my_user():
    if _me["user"] is None or time.time() - _me["at"] > 600:
        try:
            _me["user"] = json.loads(sh("tailscale", "status", "--json", timeout=5))["Self"]["UserID"]
            _me["at"] = time.time()
        except (ValueError, KeyError):
            pass
    return _me["user"]


def allowed(ip):
    if ip in ("127.0.0.1", "::1"):
        return True
    hit = _seen.get(ip)
    if hit and time.time() - hit[1] < 600:
        return hit[0]
    ok = False
    try:
        who = json.loads(sh("tailscale", "whois", "--json", ip, timeout=5))
        ok = who["Node"]["User"] == my_user() is not None
    except (ValueError, KeyError, TypeError):
        ok = False
    _seen[ip] = (ok, time.time())
    return ok


# ---------- this laptop's status ----------
def battery():
    for b in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        try:
            pct = int((b / "capacity").read_text().strip())
            st = (b / "status").read_text().strip()
            return {"pct": pct, "charging": st in ("Charging", "Full")}
        except (OSError, ValueError):
            pass
    return None


def media():
    """The playing MPRIS player, or the first one there is."""
    fmt = "{{status}}\t{{playerName}}\t{{title}}\t{{artist}}\t{{album}}\t{{mpris:length}}\t{{position}}"
    rows = [r.split("\t") for r in sh("playerctl", "-a", "metadata", "--format", fmt).splitlines() if r.count("\t") == 6]
    if not rows:
        return None
    rows.sort(key=lambda r: r[0] != "Playing")
    st, player, title, artist, album, length, pos = rows[0]
    def us(x):
        try:
            return int(x) // 1000
        except ValueError:
            return 0
    return {"playing": st == "Playing", "player": player.split(".")[0], "title": title, "artist": artist,
            "album": album, "duration": us(length), "position": us(pos), "at": int(time.time() * 1000)}


def screentime_total(day):
    try:
        d = json.loads((SCREEN / f"{day}.json").read_text())
        return round(sum(a.get("secs", 0) for a in d.get("apps", {}).values()))
    except (OSError, ValueError):
        return 0


def laptop_status():
    return {"host": socket.gethostname(), "battery": battery(), "media": media(),
            "screentime_today": screentime_total(time.strftime("%Y-%m-%d")), "at": int(time.time())}


# ---------- notes ----------
def note_index():
    NOTES.mkdir(parents=True, exist_ok=True)
    out = {}
    for p in NOTES.glob("*.md"):
        b = p.read_bytes()
        out[p.stem] = {"mtime": p.stat().st_mtime, "sha": hashlib.sha1(b).hexdigest()}
    return out


# ---------- the HTTP side ----------
class Handler(BaseHTTPRequestHandler):
    server_version = "frost-link"

    def log_message(self, *a):
        pass

    def reply(self, code, body=b"", ctype="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body, separators=(",", ":")).encode()
        elif isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n > 8 * 1024 * 1024:
            raise ValueError("too large")
        return self.rfile.read(n)

    def guard(self):
        if not allowed(self.client_address[0]):
            self.reply(403, {"error": "not one of your devices"})
            return False
        return True

    def note_id(self, path):
        nid = path[len("/notes/"):]
        return nid if ID_RE.match(nid) and nid not in (".", "..") else None

    def do_GET(self):
        if not self.guard():
            return
        p = self.path.split("?")[0]
        if p == "/hello":
            return self.reply(200, {"name": "frost-link", "version": VERSION, "host": socket.gethostname()})
        if p == "/laptop":
            return self.reply(200, laptop_status())
        if p == "/phone":
            f = LINK / "phone.json"
            return self.reply(200, f.read_bytes() if f.exists() else b"{}")
        if p == "/notes":
            return self.reply(200, note_index())
        if p.startswith("/notes/"):
            nid = self.note_id(p)
            f = NOTES / f"{nid}.md" if nid else None
            if not f or not f.exists():
                return self.reply(404, {"error": "no such note"})
            return self.reply(200, f.read_bytes(), "text/markdown; charset=utf-8")
        if p == "/screentime":
            # the last 8 days of both devices, in the tracker's own day format
            out = {"laptop": {}, "phone": {}}
            for i in range(8):
                day = time.strftime("%Y-%m-%d", time.localtime(time.time() - i * 86400))
                for dev, d in (("laptop", SCREEN), ("phone", SCREEN / "phone")):
                    try:
                        out[dev][day] = json.loads((d / f"{day}.json").read_text())
                    except (OSError, ValueError):
                        pass
            return self.reply(200, out)
        self.reply(404, {"error": "unknown"})

    def do_PUT(self):
        if not self.guard():
            return
        p = self.path.split("?")[0]
        if p.startswith("/notes/"):
            nid = self.note_id(p)
            if not nid:
                return self.reply(400, {"error": "bad id"})
            mtime = float(self.headers.get("X-Mtime") or time.time())
            write_atomic(NOTES / f"{nid}.md", self.body(), mtime)
            return self.reply(200, {"ok": True})
        self.reply(404, {"error": "unknown"})

    def do_DELETE(self):
        if not self.guard():
            return
        p = self.path.split("?")[0]
        if p.startswith("/notes/"):
            nid = self.note_id(p)
            f = NOTES / f"{nid}.md" if nid else None
            if f and f.exists():
                (NOTES / "trash").mkdir(parents=True, exist_ok=True)
                os.replace(f, NOTES / "trash" / f.name)
            return self.reply(200, {"ok": True})
        self.reply(404, {"error": "unknown"})

    def do_POST(self):
        if not self.guard():
            return
        p = self.path.split("?")[0]
        try:
            if p == "/phone/status":
                st = json.loads(self.body())
                st["received"] = int(time.time())
                write_atomic(LINK / "phone.json", json.dumps(st).encode())
                return self.reply(200, {"ok": True})
            if p == "/screentime/phone":
                days = json.loads(self.body()).get("days", {})
                for day, data in days.items():
                    if DATE_RE.match(day) and isinstance(data, dict):
                        write_atomic(SCREEN / "phone" / f"{day}.json", json.dumps(data, separators=(",", ":")).encode())
                return self.reply(200, {"ok": True, "days": len(days)})
            if p.startswith("/laptop/media/"):
                act = p.rsplit("/", 1)[1]
                if act in ("play-pause", "next", "previous"):
                    sh("playerctl", act)
                    return self.reply(200, {"ok": True})
        except (ValueError, OSError) as e:
            return self.reply(400, {"error": str(e)})
        self.reply(404, {"error": "unknown"})


def serve(addr):
    while True:
        try:
            ThreadingHTTPServer((addr, PORT), Handler).serve_forever()
        except OSError:
            time.sleep(15)      # address not there yet (Tailscale still starting): try again


def tailscale_ip():
    return sh("tailscale", "ip", "-4").splitlines()[0] if sh("tailscale", "ip", "-4") else None


def daemon():
    threading.Thread(target=serve, args=("127.0.0.1",), daemon=True).start()
    current = None
    while True:   # follow the Tailscale address (it can appear late after login)
        ip = tailscale_ip()
        if ip and ip != current:
            current = ip
            threading.Thread(target=serve, args=(ip,), daemon=True).start()
        time.sleep(30)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "daemon":
        daemon()
    elif cmd == "phone":
        f = LINK / "phone.json"
        print(f.read_text() if f.exists() else "{}")
    elif cmd == "status":
        print(json.dumps(laptop_status()))
    else:
        print(__doc__)
        sys.exit(2)
