def to_html(text):
    """Markdown -> HTML for the preview (Python-Markdown when it's there, with tasks
    drawn as boxes); None when it isn't, and Qt's own renderer is used instead."""
    try:
        import markdown
    except ImportError:
        return None
    # bare web addresses become links (not inside code)
    text = "\n".join(l if "`" in l else re.sub(r"(?<![(<\"\]])\bhttps?://[^\s)>\]]+", r"<\g<0>>", l)
                     for l in text.split("\n"))
    html = markdown.markdown(text, extensions=["fenced_code", "tables", "sane_lists", "nl2br"])
    html = re.sub(r"~~(?=\S)(.+?)(?<=\S)~~", r"<s>\1</s>", html)
    html = re.sub(r"<li>(<p>)?\[ \]\s*", r'<li>\1<span class="box">☐</span>&nbsp; ', html)
    html = re.sub(r"<li>(<p>)?\[[xX]\]\s*(.*?)(?=</p>|</li>|<ul|<ol)",
                  r'<li>\1<span class="tick">☑</span>&nbsp; <span class="done">\2</span>', html, flags=re.S)
    return html


class Editor(QPlainTextEdit):
    """The note editor, with a few Markdown habits: lists carry on, tasks tick."""

    LIST = re.compile(r"^(\s*)(?:([-*+])\s+(\[[ xX]\]\s+)?|(\d+)([.)])\s+|(>+)\s?)")
    TASK = re.compile(r"^(\s*[-*+]\s+)\[([ xX])\]")
    LINK = re.compile(r"\[[^\]]*\]\(([^)\s]+)\)|https?://[^\s)>\]]+")

    def line(self):
        c = self.textCursor()
        b = c.block()
        return c, b, b.text(), c.positionInBlock()

    def replace_line(self, block, text, col=None):
        c = QTextCursor(block)
        c.beginEditBlock()
        c.movePosition(QTextCursor.MoveOperation.EndOfBlock, QTextCursor.MoveMode.KeepAnchor)
        c.insertText(text)
        c.endEditBlock()
        if col is not None:
            c = QTextCursor(block)
            c.setPosition(block.position() + max(0, min(col, len(text))))
            self.setTextCursor(c)

    def toggle_task(self, block):
        t = block.text()
        m = self.TASK.match(t)
        col = self.textCursor().positionInBlock() if self.textCursor().block() == block else None
        if m:
            mark = " " if m.group(2) in "xX" else "x"
            self.replace_line(block, t[:m.end(1) + 1] + mark + t[m.end(1) + 2:], col)
        else:   # make it a task, keeping any list bullet
            lm = re.match(r"^(\s*)(?:[-*+]\s+)?", t)
            new = lm.group(1) + "- [ ] " + t[lm.end():]
            self.replace_line(block, new, (col or 0) + len(new) - len(t))

    def wrap(self, left, right=None):
        right = left if right is None else right
        c = self.textCursor()
        sel = c.selectedText()
        c.beginEditBlock()
        if sel:
            c.insertText(left + sel + right)
        else:
            c.insertText(left + right)
            c.movePosition(QTextCursor.MoveOperation.Left, n=len(right))
        c.endEditBlock()
        self.setTextCursor(c)

    def link(self):
        c = self.textCursor()
        sel = c.selectedText()
        if re.match(r"https?://\S+$", sel):          # a URL: give it a name, cursor in the [ ]
            c.insertText("[](" + sel + ")")
            c.setPosition(c.position() - len(sel) - 3)
        elif sel:                                       # some words: cursor in the ( ) for the URL
            c.insertText("[" + sel + "]()")
            c.movePosition(QTextCursor.MoveOperation.Left)
        else:
            c.insertText("[]()")
            c.movePosition(QTextCursor.MoveOperation.Left, n=3)
        self.setTextCursor(c)

    def keyPressEvent(self, e):
        k, mod = e.key(), e.modifiers()
        ctrl = mod & Qt.KeyboardModifier.ControlModifier
        if ctrl and k == Qt.Key.Key_B:
            return self.wrap("**")
        if ctrl and k == Qt.Key.Key_I:
            return self.wrap("*")
        if ctrl and k == Qt.Key.Key_K:
            return self.link()
        if ctrl and k in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
            return self.toggle_task(self.textCursor().block())
        c, b, t, col = self.line()
        m = self.LIST.match(t)
        if k in (Qt.Key.Key_Return, Qt.Key.Key_Enter) and not mod and m and not c.hasSelection():
            if t[m.end():].strip() == "" and col >= m.end():
                return self.replace_line(b, "", 0)          # Enter on an empty item ends the list
            ind = m.group(1)
            if m.group(2):
                nxt = ind + m.group(2) + " " + ("[ ] " if m.group(3) else "")
            elif m.group(4):
                nxt = ind + str(int(m.group(4)) + 1) + m.group(5) + " "
            else:
                nxt = ind + m.group(6) + " "
            return self.textCursor().insertText("\n" + nxt)
        if k == Qt.Key.Key_Tab and m and m.group(6) is None and not c.hasSelection():
            return self.replace_line(b, "  " + t, col + 2)
        if k == Qt.Key.Key_Backtab and m and t.startswith("  "):
            return self.replace_line(b, t[2:], max(0, col - 2))
        super().keyPressEvent(e)

    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            c = self.cursorForPosition(e.position().toPoint())
            b, col = c.block(), c.positionInBlock()
            m = self.TASK.match(b.text())
            if m and m.end(1) <= col <= m.end(1) + 3:          # on the [ ] of a task
                self.toggle_task(b)
                return
            if e.modifiers() & Qt.KeyboardModifier.ControlModifier:
                for lm in self.LINK.finditer(b.text()):
                    if lm.start() <= col <= lm.end():
                        QDesktopServices.openUrl(QUrl(lm.group(1) or lm.group(0)))
                        return
        super().mousePressEvent(e)

    def mouseMoveEvent(self, e):
        c = self.cursorForPosition(e.position().toPoint())
        m = self.TASK.match(c.block().text())
        on_box = bool(m) and m.end(1) <= c.positionInBlock() <= m.end(1) + 3
        self.viewport().setCursor(Qt.CursorShape.PointingHandCursor if on_box else Qt.CursorShape.IBeamCursor)
        super().mouseMoveEvent(e)


class Store:
    """One .md file per note. Writes are atomic, so a crash never leaves half a note."""

    def __init__(self):
        os.makedirs(os.path.join(DATA, "trash"), exist_ok=True)
        self.state_path = os.path.join(DATA, "state.json")

    def path(self, nid):
        return os.path.join(DATA, nid + ".md")

    def ids(self):
        out = []
        for f in os.listdir(DATA):
            if f.endswith(".md"):
                p = os.path.join(DATA, f)
                out.append((os.path.getmtime(p), f[:-3]))
        return [i for _, i in sorted(out, reverse=True)]

    def read(self, nid):
        try:
            with open(self.path(nid), encoding="utf-8") as f:
                return f.read()
        except OSError:
            return ""

    def mtime(self, nid):
        try:
            return os.path.getmtime(self.path(nid))
        except OSError:
            return time.time()

    def write(self, nid, text):
        p = self.path(nid)
        tmp = p + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, p)

    def new_id(self):
        return time.strftime("%Y%m%d-%H%M%S") + f"-{int(time.time() * 1000) % 1000:03d}"

    def trash(self, nid):
        try:
            os.replace(self.path(nid), os.path.join(DATA, "trash", nid + ".md"))
        except OSError:
            pass

    def load_state(self):
        try:
            with open(self.state_path) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def save_state(self, st):
        try:
            with open(self.state_path, "w") as f:
                json.dump(st, f)
        except OSError:
            pass


