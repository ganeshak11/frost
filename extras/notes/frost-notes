#!/usr/bin/env python3
"""Frost Notes: a global scratchpad that appears the instant you press its shortcut.

  frost-notes toggle    show the notes window, or hide it if it is already open
  frost-notes show|hide
  frost-notes daemon    start the background process (autostart does this at login)
  frost-notes quit

The window lives in a background process, so showing it is instant. Every note is a plain
.md file in ~/.local/share/frost-notes/, saved as you type. Deleted notes go to its trash/.

Markdown: styled as you type (headings, **bold**, *italic*, ~~strike~~, `code`, ``` blocks,
lists, - [ ] tasks, > quotes, [links](url)). Enter continues a list or task (Enter on an
empty item ends it), Tab / Shift+Tab indent a list item, Ctrl+B / Ctrl+I / Ctrl+K wrap the
selection in bold / italic / a link, Ctrl+Enter makes the line a task or ticks it, clicking
a [ ] ticks it, Ctrl+click opens a link. Ctrl+E switches to a rendered preview and back.
Bound to Alt+Y by extras/notes/install.sh.
"""
import os
import socket
import sys

SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "frost-notes.sock")
DATA = os.path.expanduser("~/.local/share/frost-notes")


def send(cmd):
    """Tell the running daemon what to do. Plain sockets: no Qt import, so it is quick."""
    try:
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(0.5)
        s.connect(SOCK)
        s.sendall(cmd.encode() + b"\n")
        s.close()
        return True
    except OSError:
        return False


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if cmd != "daemon" and send(cmd):
        sys.exit(0)
    if cmd in ("hide", "quit"):
        sys.exit(0)
    # no daemon yet: become it (and show the window, unless started from autostart)
    os.environ.setdefault("QT_QPA_PLATFORM", "wayland")
    os.environ.setdefault("QT_WAYLAND_DISABLE_WINDOWDECORATION", "1")

