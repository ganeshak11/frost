def fmt(color=None, bold=False, italic=False, size=None, strike=False, underline=False, bg=None, mono=False):
    f = QTextCharFormat()
    if color:
        f.setForeground(QColor(color))
    if bold:
        f.setFontWeight(QFont.Weight.Bold)
    if italic:
        f.setFontItalic(True)
    if size:
        f.setFontPointSize(size)
    if strike:
        f.setFontStrikeOut(True)
    if underline:
        f.setFontUnderline(True)
    if bg:
        f.setBackground(QColor(*bg) if isinstance(bg, tuple) else QColor(bg))
    return f


class Markdown(QSyntaxHighlighter):
    """Markdown styled in place: the text stays plain .md, only how it looks changes.
    The markup characters stay visible but dimmed, so editing them is never a surprise."""

    MARK = fmt(color="#55555f")
    H = {1: fmt(TEXT, bold=True, size=19), 2: fmt(TEXT, bold=True, size=16.5), 3: fmt(TEXT, bold=True, size=14.5)}
    H_SMALL = fmt(TEXT, bold=True)
    BOLD, ITALIC = fmt(bold=True), fmt(italic=True)
    STRIKE = fmt(color=MUTED, strike=True)
    CODE_F = fmt(CODE, bg=(255, 255, 255, 14))
    BLOCK = fmt(CODE, bg=(255, 255, 255, 9))
    BULLET = fmt(ACCENT, bold=True)
    BOX = fmt(ACCENT, bold=True)
    BOX_DONE = fmt("#4ade80", bold=True)
    DONE_F = fmt(DONE, strike=True)
    QUOTE = fmt(MUTED, italic=True)
    LINK_F = fmt(LINK, underline=True)
    URL = fmt("#55555f")
    RULE = fmt("#55555f")

    rx = {k: QRegularExpression(v) for k, v in {
        "head": r"^(#{1,6})\s+(.*)$",
        "task": r"^(\s*[-*+]\s+)(\[[ xX]\])(\s+)(.*)$",
        "list": r"^(\s*)([-*+]|\d+[.)])\s",
        "quote": r"^(\s*>+\s?)(.*)$",
        "rule": r"^\s*([-*_])\s*(\1\s*){2,}$",
        "bold": r"(\*\*|__)(?=\S)(.+?)(?<=\S)\1",
        "italic": r"(?<![*_\w])([*_])(?![*_\s])(.+?)(?<![*_\s])\1(?![*_\w])",
        "strike": r"(~~)(?=\S)(.+?)(?<=\S)~~",
        "code": r"(`+)(.+?)\1",
        "link": r"(\[)([^\]]+)(\]\()([^)\s]+)(\))",
        "auto": r"\bhttps?://[^\s)>\]]+",
    }.items()}

    def each(self, key, text):
        it = self.rx[key].globalMatch(text)
        while it.hasNext():
            yield it.next()

    def highlightBlock(self, text):
        # fenced code blocks (``` or ~~~) span lines: block state 1 = inside one
        fence = text.lstrip().startswith(("```", "~~~"))
        inside = self.previousBlockState() == 1
        if inside or fence:
            self.setFormat(0, len(text), self.BLOCK)
            if fence:
                self.setFormat(0, len(text), self.MARK)
            self.setCurrentBlockState(0 if (inside and fence) else 1)
            return
        self.setCurrentBlockState(0)

        m = self.rx["rule"].match(text)
        if m.hasMatch():
            self.setFormat(0, len(text), self.RULE)
            return
        m = self.rx["head"].match(text)
        if m.hasMatch():
            level = len(m.captured(1))
            self.setFormat(m.capturedStart(2), m.capturedLength(2), self.H.get(level, self.H_SMALL))
            mark = QTextCharFormat(self.MARK)
            if level in self.H:
                mark.setFontPointSize(self.H[level].fontPointSize())
            self.setFormat(0, m.capturedEnd(1), mark)
            self.inline(text, base=self.H.get(level, self.H_SMALL))
            return
        m = self.rx["task"].match(text)
        if m.hasMatch():
            done = m.captured(2).lower() == "[x]"
            self.setFormat(m.capturedStart(1), m.capturedLength(1), self.MARK)
            self.setFormat(m.capturedStart(2), 3, self.BOX_DONE if done else self.BOX)
            if done:
                self.setFormat(m.capturedStart(4), m.capturedLength(4), self.DONE_F)
                return
            self.inline(text)
            return
        m = self.rx["list"].match(text)
        if m.hasMatch():
            self.setFormat(m.capturedStart(2), m.capturedLength(2), self.BULLET)
        m = self.rx["quote"].match(text)
        if m.hasMatch():
            self.setFormat(m.capturedStart(2), m.capturedLength(2), self.QUOTE)
            self.setFormat(0, m.capturedEnd(1), self.BULLET)
        self.inline(text)

    def inline(self, text, base=None):
        def apply(start, length, f):
            if base is not None:              # keep a heading's size and weight under the inline style
                g = QTextCharFormat(base)
                g.merge(f)
                f = g
            self.setFormat(start, length, f)
        code = []
        for m in self.each("code", text):
            apply(m.capturedStart(), m.capturedLength(), self.CODE_F)
            apply(m.capturedStart(1), m.capturedLength(1), self.MARK)
            apply(m.capturedStart(0) + m.capturedLength(0) - m.capturedLength(1), m.capturedLength(1), self.MARK)
            code.append((m.capturedStart(), m.capturedEnd()))
        in_code = lambda i: any(a <= i < b for a, b in code)
        for key, f in (("bold", self.BOLD), ("italic", self.ITALIC), ("strike", self.STRIKE)):
            for m in self.each(key, text):
                if in_code(m.capturedStart()):
                    continue
                apply(m.capturedStart(2), m.capturedLength(2), f)
                mark = len(m.captured(1)) if key != "strike" else 2
                apply(m.capturedStart(), mark, self.MARK)
                apply(m.capturedEnd() - mark, mark, self.MARK)
        for m in self.each("link", text):
            if in_code(m.capturedStart()):
                continue
            apply(m.capturedStart(), m.capturedLength(), self.URL)
            apply(m.capturedStart(2), m.capturedLength(2), self.LINK_F)
        for m in self.each("auto", text):
            if not in_code(m.capturedStart()) and not (m.capturedStart() > 0 and text[m.capturedStart() - 1] == "("):
                apply(m.capturedStart(), m.capturedLength(), self.LINK_F)


