def title_of(text):
    for line in text.splitlines():
        line = re.sub(r"^(#+|>|[-*+]\s+\[[ xX]\]|[-*+]|\d+\.)\s*", "", line.strip())
        line = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", line)          # [name](url) -> name
        line = re.sub(r"(\*\*|__|~~|`|(?<!\w)[*_](?=\S)|(?<=\S)[*_](?!\w))", "", line).strip()
        if line:
            return line
    return "New note"


def ago(t):
    d = time.time() - t
    if d < 60:
        return "now"
    if d < 3600:
        return f"{int(d // 60)} min"
    if d < 86400:
        return f"{int(d // 3600)} h"
    if d < 7 * 86400:
        return time.strftime("%a", time.localtime(t))
    return time.strftime("%d %b", time.localtime(t))


class Row(QStyledItemDelegate):
    """Title in white, age in muted grey, both elided to the sidebar."""

    def paint(self, p, opt, idx):
        title, age = idx.data(Qt.ItemDataRole.DisplayRole).split("\n", 1)
        r = QRectF(opt.rect).adjusted(2, 1, -2, -1)
        if opt.state & QStyle.StateFlag.State_Selected:
            bg = QColor(242, 29, 67, 56)
        elif opt.state & QStyle.StateFlag.State_MouseOver:
            bg = QColor(255, 255, 255, 18)
        else:
            bg = None
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        if bg:
            path = QPainterPath()
            path.addRoundedRect(r, 10, 10)
            p.fillPath(path, bg)
        p.setFont(opt.font)
        fm = QFontMetrics(opt.font)
        p.setPen(QColor(TEXT))
        p.drawText(QPointF(r.left() + 10, r.top() + 22), fm.elidedText(title, Qt.TextElideMode.ElideRight, int(r.width() - 20)))
        p.setPen(QColor(MUTED))
        f = QFont(opt.font)
        f.setPixelSize(11)
        p.setFont(f)
        p.drawText(QPointF(r.left() + 10, r.top() + 40), age)


